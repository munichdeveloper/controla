# Set these in Hostinger Docker Manager, or use deploy/hostinger-env.py.
# No scheme, port or path; DNS must point to the VPS.
CONTROLA_HOST=controla.example.com
# Keep the same project name and secrets on every update.
COMPOSE_PROJECT_NAME=controla
POSTGRES_PASSWORD=
CONTROLA_SECURITY_MASTER_KEY=
JWT_SECRET=
# Optional: select a sha-<full commit> tag or pin an immutable @sha256:... digest.
CONTROLA_IMAGE=ghcr.io/munichdeveloper/controla:main
# Optional SMTP for password reset and mail alerts:
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@controla.example.com
